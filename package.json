{
  "name": "local-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "local-share": "./dist/index.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "15.5.29",
    "pino": "^10.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
